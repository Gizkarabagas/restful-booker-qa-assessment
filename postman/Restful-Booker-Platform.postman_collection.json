  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login - Admin (Positive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response returns valid auth token\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set(\"authToken\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login - Invalid Credentials (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden or 401 Unauthorized\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"invalidUser\",\n  \"password\": \"wrongPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Rooms Management",
      "item": [
        {
          "name": "Get All Rooms (Positive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Rooms list contains items with required fields\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.rooms).to.be.an('array').and.not.empty;",
                  "    const firstRoom = jsonData.rooms[0];",
                  "    pm.expect(firstRoom).to.have.property('roomid');",
                  "    pm.expect(firstRoom).to.have.property('roomName');",
                  "    pm.expect(firstRoom).to.have.property('roomPrice');",
                  "    pm.expect(firstRoom).to.have.property('type');",
                  "    pm.environment.set(\"roomId\", firstRoom.roomid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/room",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "room"
              ]
            }
          }
        },
        {
          "name": "Get Room by ID (Positive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response matches requested room ID\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.roomid).to.eql(parseInt(pm.environment.get(\"roomId\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/room/{{roomId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "room",
                "{{roomId}}"
              ]
            }
          }
        },
        {
          "name": "Get Room by Non-existent ID (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found or empty body\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([404, 500, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/room/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "room",
                "999999"
              ]
            }
          }
        }
      ]
