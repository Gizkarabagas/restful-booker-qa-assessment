    {
      "name": "3. Booking Workflow",
      "item": [
        {
          "name": "Create Booking - Valid Payload (Positive)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate random date in 2027 to avoid collision with existing bookings",
                  "const randomDay = Math.floor(Math.random() * 15) + 1;",
                  "const checkinDay = String(randomDay).padStart(2, '0');",
                  "const checkoutDay = String(randomDay + 2).padStart(2, '0');",
                  "pm.variables.set(\"dynamicCheckin\", `2027-05-${checkinDay}`);",
                  "pm.variables.set(\"dynamicCheckout\", `2027-05-${checkoutDay}`);",
                  "pm.variables.set(\"dynamicPhone\", `0812${Math.floor(10000000 + Math.random() * 90000000)}`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response returns booking confirmation with bookingid\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('bookingid');",
                  "    pm.expect(jsonData.bookingid).to.be.a('number');",
                  "    pm.expect(jsonData.firstname).to.eql(\"Alex\");",
                  "    pm.expect(jsonData.lastname).to.eql(\"Automation\");",
                  "    pm.environment.set(\"createdBookingId\", jsonData.bookingid);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomid\": {{roomId}},\n  \"firstname\": \"Alex\",\n  \"lastname\": \"Automation\",\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"{{dynamicCheckin}}\",\n    \"checkout\": \"{{dynamicCheckout}}\"\n  },\n  \"email\": \"alex.automation@testqa.io\",\n  \"phone\": \"{{dynamicPhone}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "booking"
              ]
            }
          }
        },
        {
          "name": "Create Booking - Mandatory Validation Errors (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Response returns errors array\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('errors');",
                  "    pm.expect(jsonData.errors).to.be.an('array').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomid\": {{roomId}},\n  \"firstname\": \"\",\n  \"lastname\": \"\",\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2027-01-01\",\n    \"checkout\": \"2027-01-02\"\n  },\n  \"email\": \"\",\n  \"phone\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "booking"
              ]
            }
          }
        },
        {
          "name": "Create Booking - Date Conflict Overlap (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Response indicates booking failure\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('error');",
                  "    pm.expect(jsonData.error).to.eql(\"Failed to create booking\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomid\": 1,\n  \"firstname\": \"Conflict\",\n  \"lastname\": \"Tester\",\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-02-01\",\n    \"checkout\": \"2026-02-05\"\n  },\n  \"email\": \"conflict@testqa.io\",\n  \"phone\": \"0812345678901\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "booking"
              ]
            }
          }
        },
        {
          "name": "Get Booking by ID - Authenticated (Positive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Booking record contains guest and date information\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('firstname');",
                  "    pm.expect(jsonData).to.have.property('lastname');",
                  "    pm.expect(jsonData).to.have.property('bookingdates');",
                  "    pm.expect(jsonData.bookingdates).to.have.property('checkin');",
                  "    pm.expect(jsonData.bookingdates).to.have.property('checkout');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/booking/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "booking",
                "1"
              ]
            }
          }
        },
        {
          "name": "Get Booking by ID - Unauthenticated (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden without valid auth cookie\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/booking/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "booking",
                "1"
              ]
            }
          }
        },
        {
          "name": "Delete Booking by ID - Authenticated (Positive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 202 Accepted or 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 202, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/booking/{{createdBookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "booking",
                "{{createdBookingId}}"
              ]
            }
          }
        }
      ]
    },
